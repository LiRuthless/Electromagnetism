*.exe

# 参考文献 PDF 与提取文本（约 250MB，仅本地保留）
archive/papers/

# 仿真运行输出（图表等生成物）
outputs/

# Kimi 本地工具链垫片
.toolchain/

# ================= Python =================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ================= Node / Electron =================
node_modules/
dist/
dist-ssr/
release/

# ================= 编辑器 / 系统垃圾 =================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ================= 日志与临时文件 =================
*.log
*.tmp
*.local

